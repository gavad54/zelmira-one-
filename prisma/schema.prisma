generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}
enum PlatformRole {
  OWNER
  PLATFORM_ADMIN
  SUPPORT
  USER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum ProductStatus {
  PLANNED
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum EmailPurpose {
  OWNER
  SUPPORT
  BILLING
  SECURITY
  GENERAL
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum SessionAssurance {
  PASSWORD
  MFA
}

enum AuthChallengePurpose {
  LOGIN_MFA
  MFA_ENROLLMENT
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  displayName     String
  platformRole    PlatformRole @default(USER)
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  sessions        Session[]
  auditEvents     AuditEvent[] @relation("AuditActor")
  authTokens      AuthActionToken[]
  mfa             UserMfa?
  recoveryCodes   MfaRecoveryCode[]
  authChallenges  AuthChallenge[]
  aiGenerations   AiGeneration[]
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  licenses    License[]
  auditEvents AuditEvent[]
  aiGenerations AiGeneration[]
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

model Session {
  id                 String           @id @default(cuid())
  tokenHash          String           @unique
  userId             String
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  revokedAt          DateTime?
  lastSeenAt         DateTime?
  assurance          SessionAssurance @default(PASSWORD)
  mfaAuthenticatedAt DateTime?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model Product {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String
  status      ProductStatus @default(PLANNED)
  baseUrl     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  licenses    License[]
}

model License {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  startsAt  DateTime
  endsAt    DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, active])
  @@index([productId])
  @@unique([tenantId, productId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  tenantId    String?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

model EmailContact {
  id                 String                          @id @default(cuid())
  email              String                          @unique
  label              String
  purposes           EmailPurpose[]
  enabled            Boolean                         @default(true)
  isPrimary          Boolean                         @default(false)
  verifiedAt         DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  verificationTokens EmailContactVerificationToken[]

  @@index([enabled, isPrimary])
}

model EmailContactVerificationToken {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  contactId  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())
  contact    EmailContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, expiresAt])
}

model AuthActionToken {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  userId     String
  purpose    AuthTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model AuthRateLimit {
  keyHash         String   @id
  windowStartedAt DateTime
  count           Int      @default(0)
  expiresAt       DateTime

  @@index([expiresAt])
}

model UserMfa {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  secretCiphertext        String?
  pendingSecretCiphertext String?
  pendingExpiresAt        DateTime?
  enabledAt               DateTime?
  lastTotpStep            BigInt?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuthChallenge {
  id          String               @id @default(cuid())
  challengeHash String             @unique
  userId      String
  purpose     AuthChallengePurpose
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int                  @default(0)
  maxAttempts Int                  @default(5)
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt, consumedAt])
}

model AiGeneration {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  kind      String
  prompt    String
  output    Json
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([userId, createdAt])
  @@map("AiGeneration")
}

enum EngineeringTaskStatus {
  DRAFT
  QUEUED
  RUNNING
  BLOCKED
  WAITING_APPROVAL
  WAITING_FOR_OWNER
  RETRYING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
  EXPIRED
}

model EngineeringTask {
  id                String                @id @default(cuid())
  projectKey        String                @db.VarChar(40)
  taskType          String                @db.VarChar(80)
  handlerKey        String                @db.VarChar(80)
  title             String                @db.VarChar(160)
  priority          Int                   @default(50)
  status            EngineeringTaskStatus @default(DRAFT)
  payload           Json?
  idempotencyKey    String                @unique @db.VarChar(200)
  scheduledAt       DateTime?
  deadline          DateTime?
  maxAttempts       Int                   @default(3)
  attemptCount      Int                   @default(0)
  availableAt       DateTime              @default(now())
  approvalRequired  Boolean               @default(false)
  leaseOwner        String?               @db.VarChar(100)
  leaseToken        String?               @db.VarChar(80)
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  result            Json?
  lastErrorCode     String?               @db.VarChar(80)
  lastErrorMessage  String?               @db.VarChar(500)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  attempts          EngineeringTaskAttempt[]
  dependencies      EngineeringTaskDependency[] @relation("TaskDependencies")
  dependents        EngineeringTaskDependency[] @relation("TaskDependents")
  goalFeature       GoalFeature?
  reviews           TaskReview[]

  @@index([status, availableAt, priority(sort: Desc), createdAt], map: "EngineeringTask_status_availableAt_priority_idx")
  @@index([leaseExpiresAt])
  @@index([projectKey, createdAt])
  @@map("EngineeringTask")
}

model EngineeringTaskAttempt {
  id            String          @id @default(uuid())
  taskId        String
  attemptNumber Int
  workerId      String          @db.VarChar(100)
  leaseToken    String          @db.VarChar(80)
  status        String          @db.VarChar(24)
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  errorCode     String?         @db.VarChar(80)
  errorMessage  String?         @db.VarChar(500)
  result        Json?
  task          EngineeringTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, attemptNumber])
  @@index([workerId, status])
  @@map("EngineeringTaskAttempt")
}


model EngineeringTaskDependency {
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime        @default(now())
  task            EngineeringTask @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       EngineeringTask @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Restrict)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("EngineeringTaskDependency")
}


model GoalRecord {
  id               String      @id @default(cuid())
  goalKey           String      @db.VarChar(100)
  projectKey        String      @db.VarChar(40)
  title             String      @db.VarChar(160)
  version           Int         @default(1)
  status            String      @default("PLANNED") @db.VarChar(24)
  priority          Int         @default(50)
  approvalRequired  Boolean     @default(true)
  scheduledAt       DateTime?
  deadline          DateTime?
  createdByUserId   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  epics             GoalEpic[]

  @@unique([goalKey, version])
  @@index([projectKey, status, createdAt])
  @@map("GoalRecord")
}

model GoalEpic {
  id          String        @id @default(cuid())
  goalId      String
  epicKey     String        @db.VarChar(100)
  title       String        @db.VarChar(160)
  status      String        @default("PLANNED") @db.VarChar(24)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  goal        GoalRecord    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  features    GoalFeature[]

  @@unique([goalId, epicKey])
  @@index([goalId, sortOrder])
  @@map("GoalEpic")
}

model GoalFeature {
  id                  String       @id @default(cuid())
  epicId              String
  featureKey          String       @db.VarChar(100)
  title               String       @db.VarChar(160)
  acceptanceCriteria  String       @db.VarChar(500)
  handlerKey          String       @db.VarChar(80)
  status              String       @default("PLANNED") @db.VarChar(24)
  taskId              String?      @unique
  sortOrder           Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  epic                GoalEpic     @relation(fields: [epicId], references: [id], onDelete: Cascade)
  task                EngineeringTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([epicId, featureKey])
  @@index([epicId, sortOrder])
  @@index([status])
  @@map("GoalFeature")
}

model RecurringSchedule {
  id                String    @id @default(cuid())
  scheduleKey       String    @unique @db.VarChar(100)
  projectKey        String    @db.VarChar(40)
  handlerKey        String    @db.VarChar(80)
  title             String    @db.VarChar(160)
  payload           Json?
  interval          Int
  unit              String    @db.VarChar(12)
  missedRunPolicy   String    @default("SKIP") @db.VarChar(20)
  startAt           DateTime
  nextRunAt         DateTime
  lastRunAt         DateTime?
  endAt             DateTime?
  maxRuns           Int?
  runCount          Int       @default(0)
  enabled           Boolean   @default(true)
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([projectKey, enabled])
  @@map("RecurringSchedule")
}

model EngineeringAgent {
  id           String       @id @default(cuid())
  agentKey     String       @unique @db.VarChar(64)
  version      Int
  displayName  String       @db.VarChar(100)
  capabilities Json
  permissions  Json
  projectKeys  Json
  enabled      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reviews      TaskReview[]

  @@map("EngineeringAgent")
}

model TaskReview {
  id                String           @id @default(cuid())
  taskId            String
  executorAgentKey  String           @db.VarChar(64)
  reviewerAgentId   String
  reviewRound       Int              @default(1)
  decision          String           @db.VarChar(24)
  evidence          Json
  createdAt         DateTime         @default(now())
  task              EngineeringTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer          EngineeringAgent @relation(fields: [reviewerAgentId], references: [id], onDelete: Restrict)

  @@unique([taskId, reviewRound])
  @@index([reviewerAgentId, createdAt])
  @@index([decision, createdAt])
  @@map("TaskReview")
}
