generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}
enum PlatformRole {
  OWNER
  PLATFORM_ADMIN
  SUPPORT
  USER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum ProductStatus {
  PLANNED
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum EmailPurpose {
  OWNER
  SUPPORT
  BILLING
  SECURITY
  GENERAL
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum SessionAssurance {
  PASSWORD
  MFA
}

enum AuthChallengePurpose {
  LOGIN_MFA
  MFA_ENROLLMENT
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  displayName     String
  platformRole    PlatformRole @default(USER)
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  sessions        Session[]
  auditEvents     AuditEvent[] @relation("AuditActor")
  authTokens      AuthActionToken[]
  mfa             UserMfa?
  recoveryCodes   MfaRecoveryCode[]
  authChallenges  AuthChallenge[]
  aiGenerations   AiGeneration[]
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  licenses    License[]
  auditEvents AuditEvent[]
  aiGenerations AiGeneration[]
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

model Session {
  id                 String           @id @default(cuid())
  tokenHash          String           @unique
  userId             String
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  revokedAt          DateTime?
  lastSeenAt         DateTime?
  assurance          SessionAssurance @default(PASSWORD)
  mfaAuthenticatedAt DateTime?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model Product {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String
  status      ProductStatus @default(PLANNED)
  baseUrl     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  licenses    License[]
}

model License {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  startsAt  DateTime
  endsAt    DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, active])
  @@index([productId])
  @@unique([tenantId, productId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  tenantId    String?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

model EmailContact {
  id                 String                          @id @default(cuid())
  email              String                          @unique
  label              String
  purposes           EmailPurpose[]
  enabled            Boolean                         @default(true)
  isPrimary          Boolean                         @default(false)
  verifiedAt         DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  verificationTokens EmailContactVerificationToken[]

  @@index([enabled, isPrimary])
}

model EmailContactVerificationToken {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  contactId  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())
  contact    EmailContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, expiresAt])
}

model AuthActionToken {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  userId     String
  purpose    AuthTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model AuthRateLimit {
  keyHash         String   @id
  windowStartedAt DateTime
  count           Int      @default(0)
  expiresAt       DateTime

  @@index([expiresAt])
}

model UserMfa {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  secretCiphertext        String?
  pendingSecretCiphertext String?
  pendingExpiresAt        DateTime?
  enabledAt               DateTime?
  lastTotpStep            BigInt?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuthChallenge {
  id          String               @id @default(cuid())
  challengeHash String             @unique
  userId      String
  purpose     AuthChallengePurpose
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int                  @default(0)
  maxAttempts Int                  @default(5)
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt, consumedAt])
}

model AiGeneration {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  kind      String
  prompt    String
  output    Json
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([userId, createdAt])
  @@map("AiGeneration")
}
