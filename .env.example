# Application runtime PostgreSQL connection. Never commit real credentials.
# Default application client for remaining non-tenant paths; auth must use AUTH_DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vayro_core?schema=public"

# Dedicated authentication data-plane connection.
# Must authenticate as a non-owner, non-superuser LOGIN role that is a member
# of vayro_auth, has NOBYPASSRLS, and has no elevated role memberships.
AUTH_DATABASE_URL="postgresql://AUTH_USER:PASSWORD@HOST:5432/vayro_core?schema=public"

# Dedicated platform control-plane connection.
# Non-owner, non-superuser LOGIN role that inherits only vayro_platform.
PLATFORM_DATABASE_URL="postgresql://PLATFORM_USER:PASSWORD@HOST:5432/vayro_core?schema=public"

# Dedicated tenant data-plane connection.
# Must authenticate as a non-owner, non-superuser LOGIN role that is a member
# of vayro_app, has NOBYPASSRLS, and has no elevated role memberships.
TENANT_DATABASE_URL="postgresql://TENANT_USER:PASSWORD@HOST:5432/vayro_core?schema=public"

# Separate schema-migration connection; never reuse as an application runtime URL.
# Keep this credential only in a protected deployment/CI secret store.
MIGRATION_DATABASE_URL="postgresql://MIGRATION_USER:PASSWORD@HOST:5432/vayro_core?schema=public"

# Public canonical URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set only in the hosting platform's protected environment.
NODE_ENV="development"

# Transactional email provider (leave unset until a verified sender is available).
# First adapter: resend. Keep API key in protected hosting secrets, never in Git.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""

# One-time first-owner bootstrap secret. Generate and set this only in protected hosting secrets.
# Remove it after the first OWNER account is created. Never commit a real value.
VAYRO_OWNER_BOOTSTRAP_TOKEN=""
# Resend shared test sender: only the verified Resend account inbox is allowed.
# Set EMAIL_FROM=onboarding@resend.dev and EMAIL_TEST_RECIPIENT to that exact inbox for owner-only testing.
# This mode must not be treated as customer email delivery.
EMAIL_TEST_RECIPIENT=""

# No-domain option: Gmail API OAuth (configured by the authorized mailbox owner).
# EMAIL_PROVIDER="gmail"
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""
# GMAIL_SENDER_EMAIL=""

# Set only after verifying the exact reverse-proxy chain in the chosen host.
# Number of trusted proxies that append to X-Forwarded-For; unset means IP throttles are skipped.
TRUSTED_PROXY_HOPS=""
